# 复制为 .env 后按需修改；所有变量均有默认值，不配置也能直接运行。

# ---- 服务 ----
# 默认只监听本机；配合 Nginx / 反向代理对外提供服务时保持此值即可（推荐）
MUSIC_HOST=127.0.0.1
# 若要用 IP 直连（不经反代），改成 0.0.0.0，并自行放行 Windows 防火墙与云安全组端口
# MUSIC_HOST=0.0.0.0
MUSIC_PORT=8000
MUSIC_LOG_LEVEL=info
# 对外提供服务必须设置：所有 /api/* 与 /downloads/* 需带 X-API-Key 头或 ?api_key=
# 留空 = 不鉴权，仅限本机自用；密钥切勿入库
MUSIC_API_KEY=
# 允许的前端来源，逗号分隔；* 表示全部
MUSIC_CORS_ORIGINS=*
# 是否启用内置演示页面（/）
MUSIC_DEMO_UI=true

# ---- 缓存 ----
MUSIC_CACHE_DIR=./data/cache
# 缓存总上限（MB），0 表示不限制；超出按最近最少使用淘汰
# 换算：1 GB = 1024 MB；1000 GB = 1024000（本机部署已设为该值）
MUSIC_MAX_CACHE_MB=2048
# 缓存有效期（天），0 表示永不过期（本机部署已设为 0 = 缓存不按时间清理）
MUSIC_CACHE_TTL_DAYS=30
# 字幕歌词缓存有效期（天），独立于音频缓存；0 表示永不过期
MUSIC_LYRICS_TTL_DAYS=7
# YouTube 无字幕时是否回退到 LRCLIB 第三方歌词库（按标题/歌手/时长匹配同步歌词）
MUSIC_LYRICS_EXTERNAL=true
# 单个音频文件上限（MB），0 表示不限制
MUSIC_MAX_FILE_MB=60

# ---- 音频 ----
# 输出码率 kbps，可选 64/96/128/192/256/320
MUSIC_MP3_BITRATE=192
# 拒绝超过该时长的视频（秒），0 表示不限制；防止误下整场直播
MUSIC_MAX_DURATION_SEC=900

# ---- 下载 ----
MUSIC_MAX_CONCURRENT_DOWNLOADS=2
MUSIC_YTDLP_TIMEOUT=60
MUSIC_YTDLP_RETRIES=3
MUSIC_SEARCH_MAX_LIMIT=20
# auto(默认) / python / cli：auto 优先使用 yt_dlp Python 模块，缺失时回退 yt-dlp 命令行
MUSIC_YTDLP_BACKEND=auto
# ffmpeg 可执行文件路径，留空则自动从 PATH 查找
# 以 Windows 服务（LocalSystem）运行时 PATH 通常不含 ffmpeg，建议写死绝对路径：
#   MUSIC_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe    # 用正斜杠避免 \b \f 被误解析
MUSIC_FFMPEG_PATH=

# ---- 网络（可选）----
# 代理，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
# 留空 = 显式禁用环境代理。注意：Oracle Cloud 等被 YouTube 拉黑的出口必须显式指定干净代理，
# 否则会持续报 "Sign in to confirm you're not a bot"，与登录 cookie 无关。
# 推荐本机免费 Cloudflare WARP（官方 warp-cli「mode proxy」，只开本地 SOCKS5、不改全局路由）：
#   MUSIC_PROXY=socks5://127.0.0.1:40000
#   python -m pip install PySocks    # yt-dlp 走 SOCKS5 需要
# 详见 README「用免费 WARP 换出口」章节与 tools/start_warp_proxy.ps1。
MUSIC_PROXY=
# 保留环境注入的 NODE_OPTIONS（默认会清除，因为沙箱 shim 会让 yt-dlp 的
# Node JS challenge solver 读不了脚本，见 README）。一般无需开启。
MUSIC_KEEP_NODE_OPTIONS=
# Netscape 格式 cookies 文件，用于登录态 / 年龄限制内容
# Chrome 158 请用 Cookie-Editor 导出后：
#   python tools/import_cookie_editor.py --from-file data/_clipboard_raw.txt --verify
MUSIC_COOKIES_FILE=
# 直接让 yt-dlp 从浏览器读取（需先完全关闭 Chrome；Chrome 127+ 的 v20 加密基本无效）
# 格式：浏览器[:profile[:keyring[:container]]]，例如 chrome:Profile 12
MUSIC_COOKIES_FROM_BROWSER=
# 高级：透传给 yt-dlp 的 extractor_args（JSON 对象），用于 PO Token / player_client 等
# 例：{"youtube":{"player_client":"web_safari","po_token":"xxx"}}
MUSIC_YTDLP_EXTRACTOR_ARGS=
# 额外允许的下载域名（逗号分隔），默认只允许 YouTube 相关域名
MUSIC_EXTRA_ALLOWED_HOSTS=

# ---- 异步任务 ----
MUSIC_JOB_WORKERS=4
MUSIC_JOB_TTL_SEC=3600

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.DS_Store

# ---- 本机配置 / 密钥（绝不入库）----
# .env 含真实 API Key；日志含完整请求 URL 与 api_key
.env
.env.*
!.env.example
*.log

# ---- 运行时数据（缓存音频、歌词缓存、登录态、导出备份）----
# data/ 下所有内容默认忽略，只保留两个缓存目录的 .gitkeep 占位
data/*
!data/cache/
!data/lyrics/
data/cache/*
!data/cache/.gitkeep
data/lyrics/*
!data/lyrics/.gitkeep

# 浏览器登录态、Cookie-Editor 导出、Chrome profile 备份一律不入库
data/cookies*
data/_clipboard_raw*
data/_profile_backup/

# ---- 手动下载的音频 ----
downloads/*
!downloads/.gitkeep

# ---- 本机运维产物（含个人路径 / 大体积安装包）----
# 实际续期脚本含本机绝对路径 / 域名 / 邮箱，未入库；
# 仓库提供 renew_cert.example.cmd（Windows）与 renew_cert.example.sh（Linux）模板
tools/renew_mp3_cert.cmd
tools/renew_cert.sh
tools/renew_cert.cmd
tools/warp/*
tools/_tmp*/
tests/_tmp_cache/
*.mp3
*.msi
*.exe
*.zip
